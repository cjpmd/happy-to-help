# Local Edge Function settings. `npx supabase functions serve` reads supabase/functions/.env.
# Copy this file to .env for local development. These values are for the LOCAL stack only;
# real keys go in `npx supabase secrets set` (docs/HANDOFF.md), never in the repo.

# Billing (Phase 6). Without STRIPE_SECRET_KEY, BILLING_MOCK=1 applies purchases straight away.
BILLING_MOCK=1
# A local-only signing secret, so scripts/dev/replay-stripe-webhooks.mjs and the integration
# tests can sign test events. Replace with the secret from `stripe listen` to use the Stripe CLI.
STRIPE_WEBHOOK_SECRET=whsec_local_test_only
# STRIPE_SECRET_KEY=sk_test_...   (test mode only; live keys are refused)
