# Local Edge Function settings. `npx supabase functions serve` reads supabase/functions/.env.
# Copy this file to .env for local development. These values are for the LOCAL stack only;
# real keys go in `npx supabase secrets set` (docs/HANDOFF.md), never in the repo.

# Billing (Phase 6). Without STRIPE_SECRET_KEY, BILLING_MOCK=1 applies purchases straight away.
BILLING_MOCK=1
# A local-only signing secret, so scripts/dev/replay-stripe-webhooks.mjs and the integration
# tests can sign test events. Replace with the secret from `stripe listen` to use the Stripe CLI.
STRIPE_WEBHOOK_SECRET=whsec_local_test_only
# STRIPE_SECRET_KEY=sk_test_...   (test mode only; live keys are refused)

# Integrations (Phase 7). Local-only values so the tests can sign events; real ones via
# `npx supabase secrets set` (docs/HANDOFF.md 6).
UNSUBSCRIBE_SECRET=local-only-unsubscribe-secret
INBOUND_DOMAIN=in.gumption.test
RESEND_WEBHOOK_SECRET=whsec_bG9jYWwtb25seS1yZXNlbmQtc2VjcmV0
# RESEND_API_KEY=re_...

# Calls (Phase 18): off unless CALLS_ENABLED=1. A local-only token so scripts/dev/replay-call.mjs
# can sign requests; the real one is the Twilio account's auth token (docs/HANDOFF.md 11).
CALLS_ENABLED=
TWILIO_AUTH_TOKEN=local-only-twilio-token
CALLS_WEBHOOK_URL=http://127.0.0.1:54321/functions/v1/call-webhook
# Meeting notetaker (Phase 18): off unless NOTETAKER_ENABLED=1. Calendar OAuth apps are set up by
# the platform owner (docs/HANDOFF.md 10); without client ids, connecting a calendar says so.
NOTETAKER_ENABLED=
CALENDAR_STATE_SECRET=local-only-calendar-state-secret
# GOOGLE_CLIENT_ID= GOOGLE_CLIENT_SECRET= MICROSOFT_CLIENT_ID= MICROSOFT_CLIENT_SECRET=
