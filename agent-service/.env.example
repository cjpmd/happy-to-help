# Agent service settings. Copy to .env and fill in. Never commit real keys.
#
# Supabase: the project URL and the SERVICE ROLE key (server-side only, never the frontend).
# Locally, `npx supabase status` prints API_URL and SECRET_KEY / SERVICE_ROLE_KEY.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Runtime: "mock" (default, no Anthropic calls, no cost) or "claude" (real runs on the Claude
# Agent SDK; needs ANTHROPIC_API_KEY and spends real money).
AGENT_RUNTIME=mock
ANTHROPIC_API_KEY=

# Models (CLAUDE.md rule 6): routine work, planning/building, and strategy.
MODEL_ROUTINE=claude-haiku-5-5
MODEL_PLANNING=claude-sonnet-5-5
MODEL_STRATEGY=claude-opus-5-5

# Worker
WORKER_ID=
POLL_INTERVAL_MS=3000
STALE_AFTER_MINUTES=15

# Transcription for uploaded recordings and voice notes (SPEC M): "mock" (default, nothing is
# sent anywhere) or "speechmatics" (UK company, EU processing region; see docs/HANDOFF.md 3).
TRANSCRIPTION_PROVIDER=mock
SPEECHMATICS_API_KEY=
SPEECHMATICS_URL=https://eu1.asr.api.speechmatics.com/v2

# Real providers (Phase 7). Each is used only for companies whose founder switched it on in
# Settings → Integrations; without these keys every company stays on the mocks.
# Email: Resend, sending from {company-slug}@RESEND_SENDING_DOMAIN (a domain verified in Resend).
RESEND_API_KEY=
RESEND_SENDING_DOMAIN=
# Social: Ayrshare Business; each company's profile key goes in integration_secrets.
AYRSHARE_API_KEY=
# Site metrics: PostHog (EU cloud), a personal API key with query access to the project.
POSTHOG_HOST=https://eu.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
# Signs unsubscribe links in marketing email. Must match the unsubscribe Edge Function's.
UNSUBSCRIBE_SECRET=

# Cost reconciliation (Phase 9): an Anthropic Admin API key (not a normal API key) to import the
# organisation's usage report monthly. Optional.
ANTHROPIC_ADMIN_KEY=

# The app's public address, for links Sol puts in emails (campaign links, feedback requests).
APP_URL=http://127.0.0.1:8080

# Meeting notetaker (Phase 18): off unless NOTETAKER_ENABLED=1. Without the keys below it uses the
# demo calendar and a mock bot that joins nothing (docs/HANDOFF.md 10).
NOTETAKER_ENABLED=
RECALL_API_KEY=
RECALL_BASE_URL=https://eu-central-1.recall.ai
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Calls (Phase 18): fetching and deleting call recordings (docs/HANDOFF.md 11).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Paid ads (Phase 19): off unless ADS_ENABLED=1. Launching spends real money; the Meta and Google
# adapters aren't built until the platforms approve our access (docs/HANDOFF.md 12).
ADS_ENABLED=
