# Copy to .env.local for local development. Never commit real keys.
#
# Frontend (public values only). Leave both empty to run the demo on the in-memory store.
# `npx supabase start` prints the local values (API_URL and PUBLISHABLE_KEY).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Where short links are served. Empty: the link Edge Function on the Supabase project
# (<VITE_SUPABASE_URL>/functions/v1/link). Set it once a branded short domain points at that
# function (docs/HANDOFF.md 4), e.g. https://go.example.
VITE_SHORT_LINK_BASE=
