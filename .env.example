# Copy to .env.local for local development. Never commit real keys.
#
# Frontend (public values only). Leave both empty to run the demo on the in-memory store.
# `npx supabase start` prints the local values (API_URL and PUBLISHABLE_KEY).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Where short links are served. Empty: the link Edge Function on the Supabase project
# (<VITE_SUPABASE_URL>/functions/v1/link). Set it once a branded short domain points at that
# function (docs/HANDOFF.md 4), e.g. https://go.example.
VITE_SHORT_LINK_BASE=

# Billing (Phase 6): "true" shows Stripe Checkout and the Customer Portal on the Billing page.
# Leave empty and the buttons say payments are coming soon. Test mode only (docs/HANDOFF.md 5).
VITE_BILLING_ENABLED=

# Visitor analytics on hub pages (Phase 7): PostHog's public project key and host. Only sent
# for visitors who allow analytics. Leave empty to send nothing.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
# Shown in Settings → Integrations: customers can email {company-slug}@VITE_INBOUND_DOMAIN.
VITE_INBOUND_DOMAIN=
