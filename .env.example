# Copy to .env.local for local development. Never commit real keys.
#
# Frontend (public values only). Leave both empty to run the demo on the in-memory store.
# `npx supabase start` prints the local values (API_URL and PUBLISHABLE_KEY).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
